meta {
  name: Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/user
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "John Doe",
    "role": "driver"
  }
}

docs {
  ## Create User Endpoint

  Creates a new user in the system with the provided name and role.
  Requires a valid Firebase ID token in the Authorization header.

  ### Request Body
  - `name`: String (Required)
  - `role`: "driver" | "rider" (Required)
}
