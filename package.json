{
  "dependencies": {
    "firebase": "^12.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^25.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "turbo": "^2.7.3",
    "typedoc": "^0.28.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "name": "temp-turbo",
  "packageManager": "pnpm@9.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "check:biome": "biome check .",
    "check:fix:biome": "biome check --write .",
    "dev": "turbo run dev",
    "docs": "typedoc",
    "format:biome": "biome format --write .",
    "format:check:biome": "biome format .",
    "lint:biome": "biome lint .",
    "lint:fix:biome": "biome lint --write .",
    "prepare": "husky",
    "test": "turbo run test"
  }
}
