rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own data
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rides collection - riders and assigned drivers can access their rides
    match /rides/{rideId} {
      // Allow authenticated users to read rides they're involved in
      allow read: if request.auth != null && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );

      // Allow create for authenticated users
      allow create: if request.auth != null;

      // Allow update for riders and drivers involved in the ride
      allow update: if request.auth != null && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
    }

    // Allow reading public data
    match /{document=**} {
      allow read: if request.auth != null;
    }
  }
}
