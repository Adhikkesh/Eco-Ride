rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // Users — users can read/write only their own document
    // ================================================================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ================================================================
    // Rides — only the rider and assigned driver can access a ride
    // Location data (pickup/drop coords) is isolated to participants
    // ================================================================
    match /rides/{rideId} {
      allow read: if request.auth != null && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
    }

    // ================================================================
    // Driver Profiles — only the driver themselves can read/write
    // Admins access via Admin SDK (bypasses rules)
    // ================================================================
    match /driver_profile/{driverId} {
      allow read: if request.auth != null && request.auth.uid == driverId;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // ================================================================
    // Vehicles — only the owning driver can read/write
    // ================================================================
    match /vehicle/{vehicleId} {
      allow read: if request.auth != null &&
        resource.data.driver_uid == request.auth.uid;
      allow write: if request.auth != null &&
        resource.data.driver_uid == request.auth.uid;
    }

    // ================================================================
    // Ratings — riders can create; only involved parties can read
    // ================================================================
    match /ratings/{ratingId} {
      allow read: if request.auth != null && (
        resource.data.riderId == request.auth.uid ||
        resource.data.driverId == request.auth.uid
      );
      allow create: if request.auth != null;
    }

    // ================================================================
    // DEFAULT DENY — no catch-all wildcard
    // Any collection not listed above is blocked
    // ================================================================
  }
}
