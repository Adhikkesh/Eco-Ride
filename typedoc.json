{
  "$schema": "https://typedoc.org/schema.json",
  "blockTags": [
    "@param",
    "@returns",
    "@throws",
    "@example",
    "@deprecated",
    "@default",
    "@typeParam",
    "@template",
    "@see",
    "@remarks",
    "@module",
    "@fileoverview",
    "@description",
    "@route",
    "@access"
  ],
  "categorizeByGroup": true,
