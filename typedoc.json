    "apps/backend/server/src/controllers/fareController.ts",
    "apps/backend/server/src/controllers/paymentController.ts",
    "apps/backend/server/src/controllers/rideController.ts",
    "apps/backend/server/src/controllers/adminController.ts",
    "apps/backend/server/src/controllers/userController.ts",
    "apps/backend/server/src/controllers/savedLocationsController.ts",
    "apps/backend/server/src/routes/index.ts",
    "apps/backend/server/src/middleware/authMiddleware.ts",
    "apps/backend/server/src/config/firebase.ts",
    "apps/backend/server/src/types/global.d.ts",
    "apps/backend/simulator/src/index.ts",
    "apps/backend/simulator/src/config/firebase.ts",
    "apps/backend/simulator/src/services/SimulationEngine.ts",
    "apps/backend/simulator/src/services/DriverAgent.ts",
