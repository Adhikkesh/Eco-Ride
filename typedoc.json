    "apps/web/lib/mapStyles.ts",
    "apps/web/lib/utils.ts",
    "apps/web/components/booking/BookingForm.tsx",
    "apps/web/components/booking/PaymentModal.tsx",
    "apps/web/components/maps/DriverLiveMap.tsx",
    "apps/web/components/maps/RiderMap.tsx",
    "apps/web/components/ui/button.tsx",
    "packages/shared/src/index.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "**/node_modules/**", "**/.next/**", "**/dist/**"],
  "includeVersion": true,
  "name": "Eco-Ride Documentation",
  "navigationLinks": {
    "GitHub": "https://github.com/Adhikkesh/Eco-Ride"
  },
  "out": "docs",
  "searchInComments": true,
  "tsconfig": "tsconfig.json"
