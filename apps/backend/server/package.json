{
  "dependencies": {
    "@repo/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "geofire-common": "^6.0.0",
    "http-status": "^2.1.0",
    "stripe": "^20.3.0",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.8",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typedoc": "^0.28.16",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "name": "server",
  "private": true,
  "scripts": {
    "build": "tsc -b .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:auth": "vitest run --reporter=verbose tests/controllers/authController.test.ts",
    "test:user": "vitest run --reporter=verbose tests/controllers/userController.test.ts",
    "test:ride": "vitest run --reporter=verbose tests/controllers/rideController.test.ts",
    "test:fare": "vitest run --reporter=verbose tests/controllers/fareController.test.ts tests/controllers/paymentController.test.ts",
    "test:admin": "vitest run --reporter=verbose tests/controllers/adminController.test.ts tests/controllers/savedLocationsController.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:rating": "vitest run tests/controllers/ratingController.test.ts",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "1.0.0"
}
