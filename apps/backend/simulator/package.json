{
  "dependencies": {
    "@googlemaps/polyline-codec": "^1.0.28",
    "@turf/turf": "^7.2.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/axios": "^0.14.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "name": "simulator",
  "private": true,
  "scripts": {
    "build": "tsc -b .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --reporter=verbose tests/e2e/",
    "test:e2e:agent": "vitest run --reporter=verbose tests/e2e/driver-agent.e2e.test.ts",
    "test:e2e:engine": "vitest run --reporter=verbose tests/e2e/simulation-engine.e2e.test.ts",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "1.0.0"
}
