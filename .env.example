# ============================================================
# Eco-Ride Docker Environment Configuration (Template)
# Copy this file to .env.docker and fill in your values
# ============================================================

# ---------- Server ----------
PORT=3001
GOOGLE_API_KEY=your_google_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ---------- Simulator ----------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ---------- Firebase (shared) ----------
FIREBASE_CREDENTIAL_PATH=/app/firebase_credential.json
FIREBASE_DATABASE_URL=https://eco-ride-07-default-rtdb.asia-southeast1.firebasedatabase.app/
